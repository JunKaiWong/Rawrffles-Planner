# Template only - no real values here. Copy to .env.planner and fill it in;
# that file holds the live secrets and is gitignored.
#   cp .env.example .env.planner

# --- Telegram ---
# From @BotFather when the bot was created.
TELEGRAM_BOT_TOKEN=
# Numeric ID of the one private group the bot serves. Negative for groups.
# The webhook rejects every other chat before parsing or calling any API.
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs of the two users, e.g. 123,456.
# Checked after initData signature validation on every Mini App request.
ALLOWED_USER_IDS=

# --- AI planning ---
# Primary provider for plan_date() and caption date-extraction (free tier).
GEMINI_API_KEY=
# Optional alternate provider; leave blank unless trial credits are in use.
ANTHROPIC_API_KEY=

# --- Local events ---
TICKETMASTER_API_KEY=
