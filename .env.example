# Template only - no real values here. Copy to .env.planner and fill it in;
# that file holds the live secrets and is gitignored.
#   cp .env.example .env.planner

# --- Telegram ---
# From @BotFather when the bot was created.
TELEGRAM_BOT_TOKEN=
# Numeric ID of the one private group the bot serves. Negative for groups.
# The webhook rejects every other chat before parsing or calling any API.
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs of the two users, e.g. 123,456.
# Checked after initData signature validation on every Mini App request.
ALLOWED_USER_IDS=

# --- Transport ---
# "polling" for local dev (default), "webhook" when deployed. Handlers and the
# chat allowlist are identical either way; only the startup call differs.
TELEGRAM_TRANSPORT=
# Required only when TELEGRAM_TRANSPORT=webhook: public HTTPS URL Telegram
# posts updates to, the port to bind, and an optional shared secret Telegram
# echoes back in X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_URL=
WEBHOOK_PORT=
# Required in webhook mode: it is what proves an update came from Telegram,
# since the webhook endpoint is public and carries no initData. Telegram allows
# only A-Z, a-z, 0-9, underscore and hyphen. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Storage ---
# Postgres connection string (Neon). When set it wins over DATABASE_PATH and
# the app uses Postgres; required when deployed, because Render's free plan has
# no persistent disk and a SQLite file there is erased on every redeploy.
# Leave blank locally to keep using the SQLite file.
DATABASE_URL=
# SQLite file location, used when DATABASE_URL is empty. Stays the local
# default and the fallback copy after migrating.
DATABASE_PATH=

# --- AI planning ---
# Primary provider for plan_date() and caption date-extraction (free tier).
GEMINI_API_KEY=
# Model used for caption parsing. Defaults to gemini-3.6-flash; note that
# gemini-2.5-flash is no longer issued to new API keys.
GEMINI_MODEL=

